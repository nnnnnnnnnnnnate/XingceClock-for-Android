<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="行测计时器"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="点按选择一项，长按可直接修改；到点响铃提醒"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/stageList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:choiceMode="singleChoice"
                android:divider="@null"
                android:dividerHeight="8dp"
                android:listSelector="@android:color/transparent"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/emptyHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="清单是空的，点“添加”建一项"
                android:textColor="@color/muted"
                android:textSize="17sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdd"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="添加" />

            <Button
                android:id="@+id/btnEdit"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="修改" />

            <Button
                android:id="@+id/btnDel"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="删除" />

            <Button
                android:id="@+id/btnUp"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="上移" />

            <Button
                android:id="@+id/btnDown"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="下移" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="390dp"
        android:layout_height="match_parent"
        android:layout_marginStart="28dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="总时长"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/totalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="120 分钟"
            android:textColor="@color/accent"
            android:textSize="54sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/totalCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="共 6 项"
            android:textColor="@color/muted"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/selectedInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="未选择"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="4dp"
            android:text="单独走选中项：只倒计时当前这一项。\n流水线：按清单顺序逐段计时，每段到点响铃 5 秒后自动进入下一项。"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnSingle"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:text="单独走选中项"
            android:textSize="21sp" />

        <Button
            android:id="@+id/btnPipe"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_marginTop="14dp"
            android:text="流水线整串走完"
            android:textSize="21sp" />
    </LinearLayout>

</LinearLayout>
